{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TP4 config",
    "description": "TP4 configuration properties for the unsupervised methods' hyperparameters",
    "type": "object",
    "required": [
        "method"
    ],
    "$defs": {
        "schedule": {
            "type": "object",
            "description": "A value that changes with the iteration i out of epochs · samples",
            "required": [
                "type",
                "value"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "description": "constant: value; inverse: value / (i + 1), floored at final; linear: value to final; exponential: geometric decay from value to final",
                    "enum": [
                        "constant",
                        "inverse",
                        "linear",
                        "exponential"
                    ]
                },
                "value": {
                    "type": "number",
                    "description": "Initial value",
                    "exclusiveMinimum": 0
                },
                "hyperparameters": {
                    "type": "object",
                    "description": "Hyperparameters of the schedule (if needed)",
                    "properties": {
                        "final": {
                            "type": "number",
                            "description": "Value at the last iteration (linear, exponential) or lower bound (inverse)",
                            "minimum": 0
                        }
                    },
                    "additionalProperties": false
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "enum": [
                                    "linear",
                                    "exponential"
                                ]
                            }
                        },
                        "required": [
                            "type"
                        ]
                    },
                    "then": {
                        "required": [
                            "hyperparameters"
                        ],
                        "properties": {
                            "hyperparameters": {
                                "required": [
                                    "final"
                                ]
                            }
                        }
                    }
                }
            ]
        }
    },
    "properties": {
        "method": {
            "type": "string",
            "description": "Method to run: kohonen (self-organizing map), pca (principal component analysis), oja (Oja's rule neuron) or hopfield (associative memory)",
            "enum": [
                "kohonen",
                "pca",
                "oja",
                "hopfield"
            ]
        },
        "kohonen": {
            "type": "object",
            "description": "The self-organizing map with its configuration properties",
            "required": [
                "grid_size"
            ],
            "properties": {
                "grid_size": {
                    "type": "integer",
                    "description": "k of the k × k grid of neurons",
                    "minimum": 2
                },
                "topology": {
                    "type": "string",
                    "description": "Shape of the grid: rectangular (4 neighbors at R = 1) or hexagonal (6 neighbors at R = 1)",
                    "enum": [
                        "rectangular",
                        "hexagonal"
                    ],
                    "default": "rectangular"
                },
                "similarity": {
                    "type": "string",
                    "description": "Measure used to pick the winner neuron",
                    "enum": [
                        "euclidean",
                        "exponential"
                    ],
                    "default": "euclidean"
                },
                "neighborhood": {
                    "type": "object",
                    "description": "How strongly the neurons around the winner are updated",
                    "required": [
                        "name"
                    ],
                    "properties": {
                        "name": {
                            "type": "string",
                            "description": "step: full update within R (Kohonen rule); gaussian: e^(-d² / 2R²)",
                            "enum": [
                                "step",
                                "gaussian"
                            ]
                        }
                    },
                    "default": {
                        "name": "step"
                    }
                },
                "initialization": {
                    "type": "string",
                    "description": "Initial weights: random training samples, uniform within each feature's range, or uniform in [0, 1)",
                    "enum": [
                        "samples",
                        "uniform",
                        "unit_uniform"
                    ],
                    "default": "samples"
                }
            }
        },
        "learning_rate": {
            "$ref": "#/$defs/schedule",
            "description": "Learning rate η(i), should be < 1 and decrease to 0"
        },
        "radius": {
            "$ref": "#/$defs/schedule",
            "description": "Neighborhood radius R(i) on the grid, from up to the grid size down to 1 (or constant)"
        },
        "epochs": {
            "type": "integer",
            "description": "Passes over the dataset, one sample per iteration (Kohonen: theory suggests about 500 · features iterations in total)",
            "minimum": 1
        },
        "seed": {
            "type": "integer",
            "description": "Seed for the weight initialization and the sample order (Kohonen), the initial weights (Oja) or the noise and asynchronous update order (Hopfield) (random if missing)"
        },
        "dataset": {
            "type": "object",
            "description": "The dataset to map and the columns to use",
            "required": [
                "path",
                "columns"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "description": "Path to the CSV dataset (relative to the working directory)"
                },
                "normalize": {
                    "type": "string",
                    "description": "Normalization of the input columns before training",
                    "enum": [
                        "none",
                        "z_score",
                        "min_max",
                        "unit_length"
                    ],
                    "default": "z_score"
                },
                "columns": {
                    "type": "object",
                    "description": "Columns of the dataset",
                    "required": [
                        "input"
                    ],
                    "properties": {
                        "input": {
                            "type": "array",
                            "description": "Numeric columns that make up each sample",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1,
                            "uniqueItems": true
                        },
                        "label": {
                            "type": "string",
                            "description": "Column that names each sample, used to label the results"
                        }
                    }
                }
            }
        },
        "pca": {
            "type": "object",
            "description": "Principal component analysis over the correlation matrix (the dataset is standardized by the method itself)",
            "properties": {
                "components": {
                    "type": "object",
                    "description": "How many components to keep",
                    "required": [
                        "criterion"
                    ],
                    "properties": {
                        "criterion": {
                            "type": "string",
                            "description": "kaiser: eigenvalue > 1; variance: smallest q with cumulative explained variance ≥ value; fixed: q = value",
                            "enum": [
                                "kaiser",
                                "variance",
                                "fixed"
                            ]
                        },
                        "value": {
                            "type": "number",
                            "description": "Cumulative variance threshold in (0, 1] (variance) or number of components ≥ 1 (fixed)",
                            "exclusiveMinimum": 0
                        }
                    },
                    "allOf": [
                        {
                            "if": {
                                "properties": {
                                    "criterion": {
                                        "const": "variance"
                                    }
                                },
                                "required": [
                                    "criterion"
                                ]
                            },
                            "then": {
                                "required": [
                                    "value"
                                ],
                                "properties": {
                                    "value": {
                                        "maximum": 1
                                    }
                                }
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "criterion": {
                                        "const": "fixed"
                                    }
                                },
                                "required": [
                                    "criterion"
                                ]
                            },
                            "then": {
                                "required": [
                                    "value"
                                ],
                                "properties": {
                                    "value": {
                                        "type": "integer",
                                        "minimum": 1
                                    }
                                }
                            }
                        }
                    ],
                    "default": {
                        "criterion": "kaiser"
                    }
                },
                "orientation": {
                    "type": "string",
                    "description": "Sign of each eigenvector (it's arbitrary): max_loading_positive makes its largest absolute loading positive; none keeps the solver's sign",
                    "enum": [
                        "max_loading_positive",
                        "none"
                    ],
                    "default": "max_loading_positive"
                }
            },
            "additionalProperties": false
        },
        "oja": {
            "type": "object",
            "description": "Single linear neuron trained with Oja's rule, w converges to the first principal component (the dataset must be z-score normalized)",
            "required": [
                "learning_rate"
            ],
            "properties": {
                "learning_rate": {
                    "type": "number",
                    "description": "Constant η; must satisfy η · ‖x‖² ≲ 1 (e.g. 0.001 for ~30 standardized features), larger values diverge",
                    "exclusiveMinimum": 0
                },
                "initialization": {
                    "type": "string",
                    "description": "Initial weights: uniform in [0, 1), uniform within each feature's range, or a random training sample",
                    "enum": [
                        "unit_uniform",
                        "uniform",
                        "samples"
                    ],
                    "default": "unit_uniform"
                }
            },
            "additionalProperties": false
        },
        "hopfield": {
            "type": "object",
            "description": "Discrete Hopfield network: stores ±1 patterns and recalls the one most alike a noisy query",
            "required": [
                "patterns",
                "query"
            ],
            "properties": {
                "patterns": {
                    "type": "array",
                    "description": "Pattern files to store (.png: dark = 1, light = -1; .txt: '#' = 1, '.' = -1), all of the same size; the file name is the pattern's name",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                },
                "update": {
                    "type": "string",
                    "description": "synchronous: every neuron from S(t) at once (may end in a 2-cycle); asynchronous: one neuron at a time in random order (always converges)",
                    "enum": [
                        "synchronous",
                        "asynchronous"
                    ],
                    "default": "synchronous"
                },
                "max_iterations": {
                    "type": "integer",
                    "description": "Upper bound of iterations per query (an asynchronous iteration updates every neuron once)",
                    "minimum": 1,
                    "default": 100
                },
                "query": {
                    "type": "object",
                    "description": "Noisy queries built from a stored pattern",
                    "required": [
                        "pattern",
                        "noise"
                    ],
                    "properties": {
                        "pattern": {
                            "type": "string",
                            "description": "Name (file name without extension) of the stored pattern to corrupt"
                        },
                        "noise": {
                            "type": "array",
                            "description": "Fractions of flipped entries, one query per level",
                            "items": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                            },
                            "minItems": 1
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "method": {
                        "const": "kohonen"
                    }
                },
                "required": [
                    "method"
                ]
            },
            "then": {
                "required": [
                    "kohonen",
                    "learning_rate",
                    "radius",
                    "epochs",
                    "dataset"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "method": {
                        "const": "pca"
                    }
                },
                "required": [
                    "method"
                ]
            },
            "then": {
                "required": [
                    "pca",
                    "dataset"
                ],
                "properties": {
                    "dataset": {
                        "properties": {
                            "normalize": false
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "method": {
                        "const": "oja"
                    }
                },
                "required": [
                    "method"
                ]
            },
            "then": {
                "required": [
                    "oja",
                    "epochs",
                    "dataset"
                ],
                "properties": {
                    "dataset": {
                        "properties": {
                            "normalize": {
                                "const": "z_score"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "method": {
                        "const": "hopfield"
                    }
                },
                "required": [
                    "method"
                ]
            },
            "then": {
                "required": [
                    "hopfield"
                ]
            }
        }
    ]
}
