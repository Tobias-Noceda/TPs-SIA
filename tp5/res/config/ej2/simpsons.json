{
    "autoencoder": {
        "type": "variational",
        "encoder": {
            "arquitecture": [
                {
                    "neurons": 512,
                    "activation_function": {
                        "name": "tanh"
                    }
                },
                {
                    "neurons": 128,
                    "activation_function": {
                        "name": "tanh"
                    }
                },
                {
                    "neurons": 16,
                    "activation_function": {
                        "name": "linear"
                    }
                }
            ]
        },
        "decoder": {
            "arquitecture": [
                {
                    "neurons": 128,
                    "activation_function": {
                        "name": "tanh"
                    }
                },
                {
                    "neurons": 512,
                    "activation_function": {
                        "name": "tanh"
                    }
                },
                {
                    "neurons": 3072,
                    "activation_function": {
                        "name": "logistic"
                    }
                }
            ]
        }
    },
    "variational": {
        "beta": 1
    },
    "loss_function": "bce",
    "learning_rate": {
        "type": "adam",
        "value": 0.001
    },
    "epochs": 2000,
    "batch_size": 16,
    "epsilon": 0.0001,
    "seed": 42,
    "initialization": "xavier",
    "dataset": {
        "type": "images",
        "path": "res/datasets/simpsons32",
        "size": [
            32,
            32
        ],
        "channels": 3,
        "fit": "crop"
    }
}
