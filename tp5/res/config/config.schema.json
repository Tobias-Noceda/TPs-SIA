{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TP5 config",
    "description": "TP5 configuration: autoencoder type, layers and training hyperparameters",
    "type": "object",
    "required": [
        "autoencoder",
        "learning_rate",
        "epochs",
        "dataset"
    ],
    "additionalProperties": false,
    "$defs": {
        "activation_function": {
            "type": "object",
            "description": "Activation function (name and hyperparameters if needed)",
            "required": [
                "name"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the activation function",
                    "enum": [
                        "linear",
                        "tanh",
                        "logistic",
                        "relu"
                    ]
                },
                "hyperparameters": {
                    "type": "object",
                    "description": "beta (tanh, logistic) and L (logistic), default 1.0",
                    "additionalProperties": false,
                    "properties": {
                        "beta": {
                            "type": "number",
                            "exclusiveMinimum": 0.0,
                            "default": 1.0
                        },
                        "L": {
                            "type": "number",
                            "exclusiveMinimum": 0.0,
                            "default": 1.0
                        }
                    }
                }
            }
        },
        "layer": {
            "description": "A layer: either a list of neurons, each with its own activation function, or the compact form { neurons, activation_function } for n neurons sharing one",
            "oneOf": [
                {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": [
                            "activation_function"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "activation_function": {
                                "$ref": "#/$defs/activation_function"
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "required": [
                        "neurons",
                        "activation_function"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "neurons": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Neurons in the layer"
                        },
                        "activation_function": {
                            "$ref": "#/$defs/activation_function"
                        }
                    }
                }
            ]
        },
        "network": {
            "type": "object",
            "required": [
                "arquitecture"
            ],
            "additionalProperties": false,
            "properties": {
                "arquitecture": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Layers of the network, the input layer is not written (its size is the input of the network)",
                    "items": {
                        "$ref": "#/$defs/layer"
                    }
                }
            }
        }
    },
    "properties": {
        "autoencoder": {
            "type": "object",
            "description": "The autoencoder: its type decides what main runs",
            "required": [
                "type",
                "encoder",
                "decoder"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Kind of autoencoder: basic, denoising (needs 'noise') or variational (encoder's last layer = 2·k linear neurons: μ and log Σ; decoder takes k)",
                    "enum": [
                        "basic",
                        "denoising",
                        "variational"
                    ]
                },
                "encoder": {
                    "$ref": "#/$defs/network",
                    "description": "Encoder layers; the last one is the latent space"
                },
                "decoder": {
                    "$ref": "#/$defs/network",
                    "description": "Decoder layers; its input is the latent space and its last layer must have as many neurons as pixels"
                }
            }
        },
        "loss_function": {
            "type": "string",
            "description": "hse (½ Σ), mse (mean) or bce (mean binary cross entropy, for logistic outputs)",
            "enum": [
                "hse",
                "mse",
                "bce"
            ],
            "default": "mse"
        },
        "learning_rate": {
            "type": "object",
            "description": "The learning rate (optimizer)",
            "required": [
                "value",
                "type"
            ],
            "properties": {
                "value": {
                    "type": "number",
                    "description": "The initial learning rate (α for adam)",
                    "exclusiveMinimum": 0.0
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "constant",
                        "momentum",
                        "adaptative",
                        "adam"
                    ],
                    "default": "constant"
                },
                "hyperparameters": {
                    "type": "object",
                    "description": "Hyperparameters of the learning rate. Allowed keys depend on type: momentum {alpha}, adaptative {a, b, k}, adam {beta1, beta2, epsilon}",
                    "properties": {
                        "alpha": {
                            "type": "number",
                            "minimum": 0.0,
                            "exclusiveMaximum": 1.0,
                            "default": 0.9
                        },
                        "a": {
                            "type": "number",
                            "minimum": 0.0
                        },
                        "b": {
                            "type": "number",
                            "exclusiveMinimum": 0.0,
                            "exclusiveMaximum": 1.0
                        },
                        "k": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 3
                        },
                        "beta1": {
                            "type": "number",
                            "minimum": 0.0,
                            "exclusiveMaximum": 1.0,
                            "default": 0.9
                        },
                        "beta2": {
                            "type": "number",
                            "minimum": 0.0,
                            "exclusiveMaximum": 1.0,
                            "default": 0.999
                        },
                        "epsilon": {
                            "type": "number",
                            "exclusiveMinimum": 0.0,
                            "default": 1e-08
                        }
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "constant"
                            }
                        }
                    },
                    "then": {
                        "not": {
                            "required": [
                                "hyperparameters"
                            ]
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "momentum"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "hyperparameters": {
                                "propertyNames": {
                                    "enum": [
                                        "alpha"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "adaptative"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "hyperparameters"
                        ],
                        "properties": {
                            "hyperparameters": {
                                "required": [
                                    "a",
                                    "b"
                                ],
                                "propertyNames": {
                                    "enum": [
                                        "a",
                                        "b",
                                        "k"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "adam"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "hyperparameters": {
                                "propertyNames": {
                                    "enum": [
                                        "beta1",
                                        "beta2",
                                        "epsilon"
                                    ]
                                }
                            }
                        }
                    }
                }
            ]
        },
        "epochs": {
            "type": "integer",
            "description": "Maximum number of training epochs",
            "minimum": 1
        },
        "batch_size": {
            "type": "integer",
            "description": "Samples per weight update: 1 is online learning, the dataset size is batch learning, anything in between is mini-batch",
            "minimum": 1,
            "default": 1
        },
        "epsilon": {
            "type": "number",
            "description": "Training stops once the epoch loss is below epsilon",
            "minimum": 0.0,
            "default": 1e-06
        },
        "goal_pixels": {
            "type": "integer",
            "description": "A pattern is learned when it has at most this many wrong pixels. If omitted there is no goal: training stops only by epsilon or the epochs limit",
            "minimum": 0
        },
        "stop_at_goal": {
            "type": "boolean",
            "description": "Stop training as soon as every pattern is learned (ignored without goal_pixels)",
            "default": true
        },
        "seed": {
            "type": "integer",
            "description": "Seed of the random number generator used for weight initialization and shuffling (random if omitted)",
            "minimum": 0
        },
        "initialization": {
            "type": "string",
            "description": "How the initial weights and biases are drawn: random = U(-0.5, 0.5), xavier = U(±√(6 / (inputs + 1 + neurons))) with the bias counted as one more input",
            "enum": [
                "random",
                "xavier"
            ],
            "default": "random"
        },
        "dataset": {
            "type": "object",
            "description": "Where the patterns are read from: a font.h file or a folder of images",
            "required": [
                "path"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "description": "font: font.h glyphs (binary 7x5); images: every image under the folder (recursively), label = relative path",
                    "enum": [
                        "font",
                        "images"
                    ],
                    "default": "font"
                },
                "path": {
                    "type": "string",
                    "description": "font.h file or image folder (relative to the cwd)"
                },
                "size": {
                    "type": "array",
                    "description": "[height, width] every image is resized to (images only)",
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "minItems": 2,
                    "maxItems": 2
                },
                "channels": {
                    "type": "integer",
                    "description": "1 = grayscale, 3 = RGB (images only)",
                    "enum": [
                        1,
                        3
                    ],
                    "default": 3
                },
                "fit": {
                    "type": "string",
                    "description": "Other aspect ratios: crop (central region), pad (whole image on white) or stretch (images only)",
                    "enum": [
                        "crop",
                        "pad",
                        "stretch"
                    ],
                    "default": "stretch"
                }
            }
        },
        "noise": {
            "type": "object",
            "description": "Corruption of the inputs of a denoising autoencoder (required with type denoising, not allowed otherwise). Resampled every epoch; the expected output is always the clean pattern",
            "required": [
                "type",
                "level"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "description": "flip: each pixel inverted with probability level; salt_pepper: each pixel set to 0 or 1 with probability level; gaussian: + N(0, level²) clipped to [0, 1]",
                    "enum": [
                        "flip",
                        "salt_pepper",
                        "gaussian"
                    ]
                },
                "level": {
                    "type": "number",
                    "description": "Probability per pixel (flip, salt_pepper) or standard deviation (gaussian)",
                    "minimum": 0.0,
                    "maximum": 1.0
                },
                "copies": {
                    "type": "integer",
                    "description": "Noisy versions of every pattern per epoch",
                    "minimum": 1,
                    "default": 1
                }
            }
        },
        "variational": {
            "type": "object",
            "description": "Parameters of a variational autoencoder (only with type variational; optional, beta defaults to 1)",
            "additionalProperties": false,
            "properties": {
                "beta": {
                    "type": "number",
                    "description": "λ of J = reconstruction + λ KL(q(z|x) || N(0, I)); 1 = standard ELBO",
                    "exclusiveMinimum": 0,
                    "default": 1
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "autoencoder": {
                        "properties": {
                            "type": {
                                "const": "denoising"
                            }
                        }
                    }
                },
                "required": [
                    "autoencoder"
                ]
            },
            "then": {
                "required": [
                    "noise"
                ]
            },
            "else": {
                "properties": {
                    "noise": false
                }
            }
        },
        {
            "if": {
                "properties": {
                    "autoencoder": {
                        "properties": {
                            "type": {
                                "const": "variational"
                            }
                        }
                    }
                },
                "required": [
                    "autoencoder"
                ]
            },
            "then": {},
            "else": {
                "properties": {
                    "variational": false
                }
            }
        },
        {
            "if": {
                "properties": {
                    "dataset": {
                        "properties": {
                            "type": {
                                "const": "images"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    }
                },
                "required": [
                    "dataset"
                ]
            },
            "then": {
                "properties": {
                    "dataset": {
                        "required": [
                            "size"
                        ]
                    },
                    "goal_pixels": false,
                    "stop_at_goal": false
                }
            },
            "else": {
                "properties": {
                    "dataset": {
                        "properties": {
                            "size": false,
                            "channels": false,
                            "fit": false
                        }
                    }
                }
            }
        }
    ]
}
