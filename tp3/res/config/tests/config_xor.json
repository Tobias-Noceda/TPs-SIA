{
    "$schema": "../config.schema.json",
    "perceptron": {
        "type": "multi_layer",
        "arquitecture": [
            [
                { "activation_function": { "name": "tanh" } },
                { "activation_function": { "name": "tanh" } }
            ],
            [
                {"activation_function": { "name": "tanh" } }
            ]
        ]
    },
    "learning_rate": 0.05,
    "loss_function": "hse",
    "epochs": 10000,
    "datasets": {
        "train": "res/datasets/tests/xor.csv",
        "test": "res/datasets/tests/xor.csv",
        "validation": "res/datasets/tests/xor.csv",
        "columns": {
            "input": ["x1", "x2"],
            "output": ["XOR"]
        }
    }
}
