{
    "$schema": "../config.schema.json",
    "perceptron": {
        "type": "multi_layer",
        "arquitecture": [
            [
                { "activation_function": { "name": "tanh" } },
                { "activation_function": { "name": "tanh" } },
                { "activation_function": { "name": "tanh" } }
            ],
            [
                { "activation_function": { "name": "tanh" } },
                { "activation_function": { "name": "tanh" } }
            ],
            [
                { "activation_function": { "name": "tanh" } }
            ]
        ]
    },
    "learning_rate": {
        "type": "adam",
        "value": 0.01,
        "hyperparameters": { "beta1": 0.9, "beta2": 0.999, "epsilon": 1e-8 }
    },
    "loss_function": "hse",
    "epochs": 1000,
    "classification_function": "sign",
    "datasets": {
        "shape": [2],
        "train": "res/datasets/tests/xor.csv",
        "test": "res/datasets/tests/xor.csv",
        "validation": "res/datasets/tests/xor.csv",
        "columns": {
            "input": ["x1", "x2"],
            "output": ["XOR"],
            "expected": ["XOR"]
        }
    }
}