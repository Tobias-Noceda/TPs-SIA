{
    "$schema": "../config.schema.json",
    "perceptron": {
        "type": "single_layer",
        "activation_function": {
            "name": "step"
        }
    },
    "learning_rate": 0.1,
    "loss_function": "mse",
    "epochs": 1000,
    "datasets": {
        "train": "res/datasets/tests/and.csv",
        "test": "res/datasets/tests/and.csv",
        "validation": "res/datasets/tests/and.csv",
        "columns": {
            "input": [
                "x1",
                "x2"
            ],
            "output": [
                "AND"
            ]
        }
    }
}