{
    "$schema": "../config.schema.json",
    "perceptron": {
        "type": "single_layer",
        "activation_function": { "name": "step" }
    },
    "learning_rate": {
        "type": "adam",
        "value": 0.01,
        "hyperparameters": { "beta1": 0.9, "beta2": 0.999, "epsilon": 1e-8 }
    },
    "loss_function": "hse",
    "epochs": 1000,
    "classification_function": "equals",
    "datasets": {
        "train": "res/datasets/tests/and.csv",
        "test": "res/datasets/tests/and.csv",
        "validation": "res/datasets/tests/and.csv",
        "columns": {
            "input": ["x1", "x2"],
            "output": ["AND"],
            "expected": ["AND"]
        }
    }
}