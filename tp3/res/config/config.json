{
    "$schema": "./config.schema.json",
    "perceptron": {
        "type": "single_layer",
        "activation_function": { "name": "step" }
    },
    "learning_rate": 0.1,
    "loss_function": "hse",
    "epochs": 1000,
    "classification_function": "fraud",
    "datasets": {
        "train": "res/datasets/fraud_dataset.csv",
        "test": "res/datasets/fraud_dataset.csv",
        "validation": "res/datasets/fraud_dataset.csv",
        "columns": {
            "input": ["timestamp", "amount_usd", "quantity_purchased", "session_duration_seconds", "days_since_last_purchase", "account_age_days", "device_screen_resolution", "time_since_last_login_s", "items_viewed_before_purchase"],
            "output": ["big_model_fraud_probability"],
            "expected": ["flagged_fraud"]
        }
    }
}
