{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TP3 config",
    "description": "TP3 configuration properties for the algorithms' hyperparameters",
    "type": "object",
    "required": [
        "perceptron",
        "learning_rate",
        "epochs",
        "classification_function",
        "datasets"
    ],
    "properties": {
        "perceptron": {
            "type": "object",
            "description": "The perceptron with its configuration properties",
            "required": ["type"],
            "properties": {
                "type": {
                    "type": "string",
                    "description": "The type of the perceptron to use",
                    "enum": ["single_layer", "multi_layer"]
                },
                "activation_function": {
                    "type": "object",
                    "description": "The activation function to use for the perceptron (name and hyperparameters if needed)",
                    "required": ["name"],
                    "properties": {
                        "name": {
                            "type": "string",
                            "description": "The name of the activation function to use for the perceptron",
                            "enum": ["step", "linear", "tanh", "logistic", "relu", "sigmoid"]
                        },
                        "hyperparameters": {
                            "type": "object",
                            "description": "The hyperparameters for the activation function (if needed)",
                            "properties": {
                                "beta": {
                                    "type": "number",
                                    "description": "The beta hyperparameter for the activation function (if needed), default is 1.0",
                                    "default": 1.0
                                },
                                "L": {
                                    "type": "number",
                                    "description": "The L hyperparameter for the activation function (if needed), default is 1.0",
                                    "default": 1.0
                                }
                            },
                            "default": {
                                "beta": 1.0,
                                "L": 1.0
                            }
                        }
                    }
                },
                "arquitecture": {
                    "type": "array",
                    "description": "The architecture of the multi-layer perceptron (neurons array for each layer)",
                    "items": {
                        "type": "array",
                        "description": "The neurons array for a layer",
                        "items": {
                            "type": "object",
                            "description": "The neuron with its configuration properties",
                            "required": ["activation_function"],
                            "properties": {
                                "activation_function": {
                                    "type": "object",
                                    "description": "The activation function to use for the neuron (name and hyperparameters if needed)",
                                    "required": ["name"],
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "description": "The name of the activation function to use for the neuron",
                                            "enum": ["linear", "tanh", "logistic", "relu", "sigmoid"]
                                        },
                                        "hyperparameters": {
                                            "type": "object",
                                            "description": "The hyperparameters for the activation function (if needed)",
                                            "properties": {
                                                "beta": {
                                                    "type": "number",
                                                    "description": "The beta hyperparameter for the activation function (if needed), default is 1.0",
                                                    "default": 1.0
                                                },
                                                "L": {
                                                    "type": "number",
                                                    "description": "The L hyperparameter for the activation function (if needed), default is 1.0",
                                                    "default": 1.0
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "if": {
                "properties": {
                "type": { "const": "single_layer" }
                },
                "required": ["type"]
            },
            "then": {
                "required": ["activation_function"]
            },
            "else": {
                "required": ["arquitecture"]
            }
        },
        "loss_function": {
            "type": "string",
            "description": "The loss function to use for the perceptron",
            "enum": ["hse", "mse"],
            "default": "hse"
        },
        "learning_rate": {
            "type": "object",
            "description": "The learning rate for the perceptron",
            "required": ["value", "type"],
            "properties": {
                "value": { "type": "number", "description": "The initial learning rate (α for adam)", "exclusiveMinimum": 0.0 },
                "type": {
                    "type": "string",
                    "enum": ["constant", "momentum", "adaptative", "adam"],
                    "default": "constant"
                },
                "hyperparameters": {
                    "type": "object",
                    "description": "Hyperparameters of the learning rate. Allowed keys depend on type: momentum {alpha}, adaptative {a, b, k}, adam {beta1, beta2, epsilon}",
                    "properties": {
                        "alpha": { "type": "number", "minimum": 0.0, "exclusiveMaximum": 1.0, "default": 0.9 },
                        "a": { "type": "number", "minimum": 0.0 },
                        "b": { "type": "number", "exclusiveMinimum": 0.0, "exclusiveMaximum": 1.0 },
                        "k": { "type": "integer", "minimum": 1, "default": 3 },
                        "beta1": { "type": "number", "minimum": 0.0, "exclusiveMaximum": 1.0, "default": 0.9 },
                        "beta2": { "type": "number", "minimum": 0.0, "exclusiveMaximum": 1.0, "default": 0.999 },
                        "epsilon": { "type": "number", "exclusiveMinimum": 0.0, "default": 1e-8 }
                    }
                }
            },
            "allOf": [
                {
                    "if": { "properties": { "type": { "const": "constant" } } },
                    "then": { "not": { "required": ["hyperparameters"] } }
                },
                {
                    "if": { "properties": { "type": { "const": "momentum" } } },
                    "then": {
                        "properties": {
                            "hyperparameters": { "propertyNames": { "enum": ["alpha"] } }
                        }
                    }
                },
                {
                    "if": { "properties": { "type": { "const": "adaptative" } } },
                    "then": {
                        "required": ["hyperparameters"],
                        "properties": {
                            "hyperparameters": {
                                "required": ["a", "b"],
                                "propertyNames": { "enum": ["a", "b", "k"] }
                            }
                        }
                    }
                },
                {
                    "if": { "properties": { "type": { "const": "adam" } } },
                    "then": {
                        "properties": {
                            "hyperparameters": { "propertyNames": { "enum": ["beta1", "beta2", "epsilon"] } }
                        }
                    }
                }
            ]
        },
        "seed": {
            "type": "integer",
            "description": "The seed for the random number generator used for weight initialization and shuffling (random if omitted)",
            "minimum": 0
        },
        "epsilon": {
            "type": "number",
            "description": "Training stops once the epoch error is below epsilon",
            "minimum": 0.0,
            "default": 1e-6
        },
        "epochs": {
            "type": "integer",
            "description": "The number of epochs to train the perceptron",
            "minimum": 1
        },
        "batch_size": {
            "type": "integer",
            "description": "Samples per weight update: 1 is online learning, the training set size is batch learning, anything in between is mini-batch",
            "minimum": 1,
            "default": 1
        },
        "classification_function": {
            "type": "string",
            "description": "The classification function to use for testing the perceptron",
            "enum": ["fraud", "digits", "equals", "similar", "sign"]
        },
        "datasets": {
            "type": "object",
            "description": "Paths to the datasets for training, testing and validation and the columns to use for the input and output of the perceptron",
            "required": ["train", "test", "validation", "columns"],
            "properties": {
                "train": {
                    "type": "string",
                    "description": "Path to the training dataset"
                },
                "test": {
                    "type": "string",
                    "description": "Path to the testing dataset"
                },
                "validation": {
                    "type": "string",
                    "description": "Path to the validation dataset"
                },
                "normalize": {
                    "type": "boolean",
                    "description": "Standardize every input column (z-score) using the training set mean and standard deviation, also applied to test and validation",
                    "default": false
                },
                "columns": {
                    "type": "object",
                    "description": "Columns to use for the input and output of the perceptron",
                    "required": ["input", "output", "expected"],
                    "properties": {
                        "input": {
                            "type": ["array", "string"],
                            "description": "Columns to use for the input of the perceptron. It may be multiple numeric columns, or a single stringified array column",
                            "items": {
                                "type": "string"
                            },
                            "minLength": 1
                        },
                        "output": {
                            "type": ["array", "string"],
                            "description": "Columns to use for the output of the perceptron. It might be multiple numeric columns, or single values mapped into a matrix of 0 and 1 (eg.: [0, 0, 1, 0, ...])",
                            "items": {
                                "type": "string"
                            },
                            "minLength": 1
                        },
                        "expected": {
                            "type": ["array", "string"],
                            "description": "Columns to use for the expected output of the perceptron. It might be multiple numeric columns, or single values mapped into a matrix of 0 and 1 (eg.: [0, 0, 1, 0, ...])",
                            "items": {
                                "type": "string"
                            },
                            "minLength": 1
                        }
                    }
                }
            }
        }
    }
}
